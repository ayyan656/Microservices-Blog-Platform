# ============================================================================
# User Service Environment Configuration - COPY TO .env FOR LOCAL DEVELOPMENT
# ============================================================================
# IMPORTANT: This file is a template. Create a .env file in this directory
# with actual values. NEVER commit the real .env file to git.
# ============================================================================

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=blog_db
DB_USER=blog_user
DB_PASSWORD=SecurePassword123!

# ============================================================================
# REDIS CACHE
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Optional if Redis authentication is enabled
REDIS_PASSWORD=

# ============================================================================
# RABBITMQ MESSAGE BROKER
# ============================================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# Alternative format for granular control:
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens (use strong, random string in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ============================================================================
# APPLICATION
# ============================================================================
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# RATE LIMITING
# ============================================================================
# Rate limiter settings (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# SECURITY
# ============================================================================
# CORS settings
CORS_ORIGIN=http://localhost:3000
# BCrypt rounds for password hashing
BCRYPT_ROUNDS=10

# ============================================================================
# OPTIONAL: MONITORING & OBSERVABILITY
# ============================================================================
# Sentry DSN for error tracking
SENTRY_DSN=

# DataDog APM
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8126

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================
# 1. Change JWT_SECRET to a strong, random value
# 2. Use strong database password (min 12 chars, mix of upper/lower/numbers/special)
# 3. Enable HTTPS/TLS in production
# 4. Use environment-specific .env files (.env.production, .env.staging)
# 5. Never commit .env files to version control
# 6. Rotate secrets regularly
# 7. Use AWS Secrets Manager, HashiCorp Vault, or similar in production
# ============================================================================
